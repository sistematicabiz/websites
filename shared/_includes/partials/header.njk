{#- Sticky site header: brand mark + main nav (site settings "nav", else sites/<site>/src/_data/nav.yml). -#}
<header class="site"><div class="wrap">
  {% include "partials/brand-" + site.id + ".njk" %}
  <nav aria-label="Main"><ul>
    {%- for item in (site.nav or nav) %}<li><a href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>{% endfor -%}
  </ul></nav>
</div></header>