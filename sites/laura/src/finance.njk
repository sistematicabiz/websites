---
layout: layouts/laura-page.njk
bodyClass: pg-c2
permalink: /finance/
eleventyComputed:
  description: "{{ pages.finance.description | safe }}"
  title: "{{ pages.finance.title | safe }}"
---
{#- All text comes from content/laura/pages/finance.md (CMS: Pages > Finance & Climate); cards from content/shared/roles. -#}
{% from "macros/links.njk" import linkAttrs, arrow %}
{#- Role cards (show_on_finance) for one group. -#}
{% macro roleCards(group) %}
  <div class="fields" style="--n:2">
    {%- for r in roles %}{% if r.show_on_finance and r.group == group %}
    <a class="fd f{{ r.colour | replace('c', '') if r.colour and r.colour != 'none' else '0' }}" {{ linkAttrs(r.link_url) }}><span class="lbl">{{ r.role }}</span><h3>{{ r.organization | brand | safe }}</h3>{{ r.html | safe }}<span class="go">{{ r.link_label | brand | safe }}{{ arrow(r.link_url) }}</span></a>
    {%- endif %}{% endfor %}
  </div>
{% endmacro %}
{%- set p = pages.finance -%}
{% set hero = p.hero %}{% include "partials/page-hero.njk" %}
<section class="wrap p-sec"><div class="p-two">
  <div class="side"><span class="lbl">{{ p.work.eyebrow }}</span></div>
  <div class="main">{{ p.work.body | md | safe }}</div>
</div></section>
<section class="wrap p-sec">
  <div style="display:grid;gap:12px;margin-bottom:28px"><span class="lbl">{{ p.advisory_heading }}</span></div>
  {{ roleCards("Advisory & investment") }}
</section>
<section class="wrap p-sec">
  <div style="display:grid;gap:12px;margin-bottom:28px"><h2 class="p-h2">{{ p.boards_heading | soft | safe }}</h2></div>
  {{ roleCards("Boards & other initiatives") }}
</section>
