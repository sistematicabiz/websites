---
layout: layouts/laura-page.njk
bodyClass: pg-c3
permalink: /moral-revolution/
eleventyComputed:
  description: "{{ pages.writing.description | safe }}"
  title: "{{ pages.writing.title | safe }}"
---
{#- All text comes from content/laura/pages/writing.md (CMS: Pages > Writing & Podcast); links from site settings. -#}
{% from "macros/links.njk" import linkAttrs %}
{%- set p = pages.writing -%}
{% set hero = p.hero %}{% include "partials/page-hero.njk" %}
<section class="wrap p-sec"><div class="p-two">
  <div class="side"><span class="lbl">{{ p.project.eyebrow }}</span>
    <div class="actions" style="margin-top:8px"><a class="btn btn-substack" {{ linkAttrs(site.links.substack) }}>{{ p.project.substack_label }} ↗</a><a class="btn line btn-apple" {{ linkAttrs(site.links.apple_podcasts) }}>{{ p.project.apple_label }} ↗</a><a class="btn line btn-spotify" {{ linkAttrs(site.links.spotify) }}>{{ p.project.spotify_label }} ↗</a></div></div>
  <div class="main">
    {{ p.project.body | md | safe }}
  </div>
</div></section>
<section class="wrap p-sec"><h2 class="sr-only">Questions</h2><div class="fields" style="--n:{{ p.questions.length }}">
  {%- for q in p.questions %}
  <div class="fd f{{ q.colour | replace('c', '') if q.colour and q.colour != 'none' else '0' }}"><span class="lbl">{{ q.label }}</span><h3>{{ q.question | soft | safe }}</h3>{% if q.text %}<p>{{ q.text }}</p>{% endif %}</div>
  {%- endfor %}
</div></section>
{%- if substack.items.length %}
<section class="wrap p-sec">
  <div style="display:flex;justify-content:space-between;align-items:end;gap:16px;flex-wrap:wrap;margin-bottom:28px"><h2 class="p-h2">{{ p.substack.title | soft | safe }}</h2></div>
  <div class="press-list">
    {%- for post in substack.items %}
    <a class="pi" {{ linkAttrs(post.link) }}><span class="src">{{ "Podcast" if post.type == "podcast" else "Essay" }}{% if post.date %} · {{ post.date | longDate }}{% endif %}</span><div><h3>{{ post.title }}</h3>{% if post.excerpt %}<p>{{ post.excerpt }}</p>{% endif %}</div><span class="go">{{ p.substack.listen_label if post.type == "podcast" else p.substack.read_label }} ↗</span></a>
    {%- endfor %}
  </div>
</section>
{%- endif %}
