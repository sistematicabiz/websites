---
layout: layouts/base.njk
---
<header class="page-header">
  <div class="wrap">
    {% if eyebrow and eyebrow != title %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
    <h1>{{ title }}</h1>
    {% if abstract %}<p class="lede">{{ abstract }}</p>{% endif %}
  </div>
</header>
<div class="section">
  <div class="wrap prose">
    {{ content | safe }}
  </div>
</div>
