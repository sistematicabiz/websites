---
layout: layouts/laura-page.njk
bodyClass: pg-c1
permalink: /teaching/
eleventyComputed:
  description: "{{ pages.teaching.description | safe }}"
  title: "{{ pages.teaching.title | safe }}"
---
{#- All text comes from content/laura/pages/teaching.md (CMS: Pages > Teaching & Research). -#}
{% from "macros/links.njk" import linkAttrs %}
{%- set p = pages.teaching -%}
{% set hero = p.hero %}{% include "partials/page-hero.njk" %}
<section class="wrap p-sec"><div class="p-two">
  <div class="side"><span class="lbl">{{ p.columbia.eyebrow }}</span><a class="btn" {{ linkAttrs(p.columbia.profile_url) }} style="justify-self:start">{{ p.columbia.profile_label }} ↗</a></div>
  <div class="main">{{ p.research.body | md | safe }}</div>
</div></section>
<section class="wrap p-sec">
  <div style="display:grid;gap:12px;margin-bottom:28px"><span class="lbl">{{ p.research.interests_heading }}</span></div>
  <ol class="num">
    {%- for i in p.research.interests %}
    <li>{{ i }}</li>
    {%- endfor %}
  </ol>
</section>
<section id="land" class="landf"><div class="wrap">
  <figure style="margin:0;display:grid;gap:8px"><img src="{{ p.land.photo }}" alt="{{ p.land.photo_alt }}"{{ p.land.photo | imgSize | safe }}><span class="lbl">{{ p.land.photo_caption }}</span></figure>
  <div class="main">
    <span class="lbl">{{ p.land.eyebrow }}</span>
    <h2 class="p-h2">{{ p.land.title | soft | safe }}</h2>
    {{ p.land.body | md | safe }}
    <div class="oikos-card"><span class="lbl">{{ p.oikos.eyebrow }}</span><h3>{{ p.oikos.title | soft | safe }}</h3>
      {{ p.oikos.body | md | safe }}</div>
  </div>
</div></section>
