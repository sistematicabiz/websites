---
layout: layouts/laura-page.njk
bodyClass: pg-c4
permalink: /about/
eleventyComputed:
  description: "{{ pages.about.description | safe }}"
  title: "{{ pages.about.title | safe }}"
---
{#- All text comes from content/laura/pages/about.md (CMS: Pages > About); roles from content/shared/roles. -#}
{% from "macros/links.njk" import linkAttrs, arrow %}
{%- set p = pages.about -%}
{% set hero = p.hero %}{% include "partials/page-hero.njk" %}
<section class="wrap p-sec"><div class="p-two">
  <div class="side"><span class="lbl">{{ p.who.eyebrow }}</span><p class="pull">{{ p.who.opening_line }}</p></div>
  <div class="main">
    {{ p.who.body | md | safe }}
  </div>
</div></section>
<section class="wrap p-sec">
  <div style="display:grid;gap:12px;margin-bottom:28px"><h2 class="p-h2">{{ p.roles_title | soft | safe }}</h2></div>
  <div class="rows">
    {%- for r in roles %}{% if r.show_on_about %}
    <a class="row" {{ linkAttrs(r.link_url) }}><b>{{ r.organization | brand | safe }}</b><span>{{ r.short_line }}</span><span class="go">{{ r.short_link_label or r.link_label }}{{ arrow(r.link_url) }}</span></a>
    {%- endif %}{% endfor %}
  </div>
</section>
<section class="wrap p-sec"><div class="p-two p-with-photo">
  <div class="side"><span class="lbl">{{ p.appearances.eyebrow }}</span><p class="names">{% for n in p.appearances.names %}{{ n }}{% if not loop.last %} <i>·</i> {% endif %}{% endfor %}</p><a class="btn line" {{ linkAttrs(site.links.linkedin) }} style="justify-self:start">{{ p.appearances.linkedin_label }} ↗</a></div>
  {%- if p.appearances.photo %}
  <figure class="p-photo"><figcaption class="vert">{{ p.appearances.photo_caption }}</figcaption><img src="{{ p.appearances.photo }}" alt="{{ p.appearances.photo_alt }}" loading="lazy"{{ p.appearances.photo | imgSize | safe }}></figure>
  {%- endif %}
</div></section>
