---
layout: layouts/base.njk
title: Home
---
<section class="hero">
  <div class="wrap hero__grid">
    <div class="flow">
      <p class="eyebrow">Placeholder eyebrow</p>
      <h1>{{ profile.name }}</h1>
      <p class="lede">Placeholder one-line positioning statement. Replace with the agreed hero copy.</p>
      <p><a class="button" href="/about/">About Laura</a></p>
    </div>
    <img class="hero__portrait" src="{{ profile.headshot }}" alt="{{ profile.headshotAlt }}" width="400" height="400">
  </div>
</section>

<section class="section section--tint" aria-labelledby="work-heading">
  <div class="wrap flow flow--loose">
    <h2 id="work-heading">Work</h2>
    <div class="tiles tiles--mosaic">
      {%- for item in collections.section | byOrder %}
      <a class="tile tile--{{ item.data.tile }}" href="{{ item.url }}">
        <h3>{{ item.data.nav_label or item.data.title }}</h3>
        <p>{{ item.data.abstract }}</p>
        <span class="tile__more">Read more &rarr;</span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>
