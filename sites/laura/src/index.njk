---
layout: layouts/laura.njk
eleventyComputed:
  description: "{{ pages.home.description | safe }}"
  title: ""
---
{#- Home. All text comes from content/laura/pages/home.md (CMS: Pages > Home). -#}
{% from "macros/contact.njk" import contactCard with context %}
{% from "macros/links.njk" import linkAttrs, arrow %}
{%- set p = pages.home -%}
<section class="wrap hero">
  <div class="h-name">
    <h1>{% for line in p.hero.name_lines %}<span>{{ line | soft | safe }}</span>{% if not loop.last %} {% endif %}{% endfor %}</h1>
    <div class="row">
      <p class="descr">{{ p.hero.tagline }}</p>
      <div style="display:grid;gap:18px">
        {{ p.hero.intro | md | safe }}
        <div class="actions">{% for b in p.hero.buttons %}<a class="btn{% if not loop.first %} line{% endif %}" {{ linkAttrs(b.url) }}>{{ b.label }}{% if b.url | isExternal %} ↗{% endif %}</a>{% endfor %}</div>
      </div>
    </div>
  </div>
  <div class="h-cols">
    <div class="y"><span class="vert">{{ p.hero.photo_caption }}</span><img src="{{ p.hero.photo }}" alt="{{ p.hero.photo_alt }}"{{ p.hero.photo | imgSize | safe }}></div>
    <div class="r">{% set monoFill = "var(--on-c1)" %}{% set monoAccent = "var(--on-c1)" %}{% set monoAccentOpacity = ".5" %}{% include "partials/mono.njk" %}</div>
    <div class="g">{{ p.hero.themes_line }}</div>
  </div>
</section>

<h2 class="sr-only">Areas of work</h2>
<section id="areas" class="areas">
  {%- for a in p.areas %}
  <a class="col" {{ linkAttrs(a.link_url) }}><span class="lbl">{{ a.eyebrow | brand | safe }}</span><h3>{{ a.title | soft | safe }}</h3><p>{{ a.text }}</p><span class="go">{{ a.link_label }}{{ arrow(a.link_url) }}</span></a>
  {%- endfor %}
</section>

{%- set mr = p.moral_revolution %}
<section id="mr" class="blue"><div class="wrap mr">
  <h2 aria-label="{{ mr.title_lines | titleName }}">{% for line in mr.title_lines %}<span aria-hidden="true">{{ line | soft | safe }}</span>{% endfor %}</h2>
  <div class="txt">
    <img src="{{ mr.photo }}" alt="{{ mr.photo_alt }}"{{ mr.photo | imgSize | safe }}>
    <span class="lbl">{{ mr.eyebrow }}</span>
    {{ mr.text | md | safe }}
    {%- set episode = substack.items | latestEpisode %}
    {%- if episode %}
    <a class="mr-latest" {{ linkAttrs(episode.link) }}><span class="lbl">{{ mr.latest_label }}:</span> <span class="mr-latest-title">{{ episode.title }}{% if episode.link | isExternal %}&#8288;&nbsp;&#8288;↗{% endif %}</span></a>
    {%- endif %}
    <div class="actions"><a class="btn btn-substack" {{ linkAttrs(site.links.substack) }}>{{ mr.substack_label }} ↗</a><a class="btn line btn-apple" {{ linkAttrs(site.links.apple_podcasts) }}>{{ mr.apple_label }} ↗</a><a class="btn line btn-spotify" {{ linkAttrs(site.links.spotify) }}>{{ mr.spotify_label }} ↗</a></div>
  </div>
</div></section>

{%- set land = p.land %}
<section id="land" class="land">
  <div class="y"><span class="vert" style="padding-bottom:28px">{{ land.photo_caption }}</span><img src="{{ land.photo }}" alt="{{ land.photo_alt }}"{{ land.photo | imgSize | safe }}></div>
  <div class="t">
    <span class="lbl">{{ land.eyebrow }}</span>
    <h2>{{ land.title | soft | safe }}</h2>
    {{ land.text | md | safe }}
    <div class="oikos"><span class="lbl">{{ land.oikos_eyebrow }}</span><p>{{ land.oikos_text }}</p></div>
  </div>
</section>

<section id="press" class="offw"><div class="wrap press-wrap">
  <div><span class="lbl">{{ p.press.eyebrow }}</span><h2>{{ p.press.title | soft | safe }}</h2></div>
  <div class="press">
    {%- for item in speaking %}{% if item.featured %}
    {% include "partials/press-card.njk" %}
    {%- endif %}{% endfor %}
  </div>
</div></section>

{{ contactCard({ field: "red", label: p.contact.eyebrow, title: p.contact.title | soft }) }}
