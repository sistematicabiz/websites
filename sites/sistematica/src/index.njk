---
layout: layouts/sistematica.njk
eleventyComputed:
  title: ""
  description: "{{ pages.home.description | safe }}"
---
{#- Home. All text comes from content/sistematica/pages/home.md (CMS: Pages (Sistematica) > Home);
    collaborations and role chips come from their collections. -#}
{% from "macros/contact.njk" import contactCard with context %}
{% from "macros/links.njk" import linkAttrs, arrow %}
{%- set p = pages.home -%}
<section id="home" class="wrap s-hero">
  <div class="s-name">
    <span class="lbl">{{ p.hero.eyebrow | soft | safe }}</span>
    <h1 aria-label="Sistematica"><span>Sistem</span><span><i class="g">at</i></span><span>ica</span></h1>
    <p class="tag">{{ p.hero.subtitle | soft | safe }}</p>
    <div class="row">
      <p style="font-size:21px;line-height:1.35;font-weight:500">{{ p.hero.lead }}</p>
      <div style="display:grid;gap:18px">{{ p.hero.text | md | trim | safe }}
      <div class="actions">{% for b in p.hero.buttons %}<a class="btn{% if not loop.first %} line{% endif %}" {{ linkAttrs(b.url) }}>{{ b.label }}{% if b.url | isExternal %} ↗{% endif %}</a>{% endfor %}</div></div>
    </div>
  </div>
  <div class="s-side">
    <div class="m"><span class="vert">{{ p.hero.photo_caption }}</span><img src="{{ p.hero.photo }}" alt="{{ p.hero.photo_alt }}"{{ p.hero.photo | imgSize | safe }}></div>
    <div class="meter" aria-hidden="true"><i style="height:22%"></i><i style="height:30%"></i><i style="height:26%"></i><i style="height:38%"></i><i style="height:46%"></i><i style="height:42%"></i><i style="height:55%"></i><i style="height:63%"></i><i style="height:60%"></i><i style="height:74%"></i><i style="height:86%"></i><i class="sun" style="height:100%"></i></div>
  </div>
</section>

{%- set aw = p.at_work %}
<section class="atwork" aria-label="{{ aw.title | replace('*', '') }}"><div class="wrap aw">
  <figure><img data-sizes="(max-width:1000px) 95vw, (min-width:1440px) 860px, 62vw" src="{{ aw.photo }}" alt="{{ aw.photo_alt }}"{{ aw.photo | imgSize | safe }}></figure>
  <div class="aw-t">
    <p class="aw-big">{{ aw.title | soft | safe }}</p>
    <p>{{ aw.text }}</p>
    <small>{{ aw.credit }}</small>
  </div>
</div></section>

<h2 class="sr-only">What I do</h2>
<section id="what" class="svc">
  {%- for a in p.practice_areas %}
  <article class="sv"><span class="n">{{ "0" if loop.index < 10 }}{{ loop.index }}</span><h3>{{ a.title | soft | safe }}</h3>{{ a.text | md | replace("\n", "") | safe }}</article>
  {%- endfor %}
</section>
<section class="eng-wrap"><div class="wrap eng">
  <div style="display:grid;gap:12px;align-content:start"><span class="lbl">{{ p.engagements.eyebrow }}</span><h2>{{ p.engagements.title | soft | safe }}</h2></div>
  <ol>
    {%- for e in p.engagements.items %}
    <li>{{ e }}</li>
    {%- endfor %}
  </ol>
</div></section>

<section class="why"><div class="wrap">
  <h2 class="lbl">{{ p.why.eyebrow }}</h2>
  <div class="big">{% for line in p.why.title_lines %}{% if loop.first %}{{ line | soft | safe }}{% else %}<br><span>{{ line | soft | safe }}</span>{% endif %}{% endfor %}</div>
  <div class="cols">
    {%- for c in p.why.commitments %}
    <div><h3>{{ c.title | soft | safe }}</h3><p>{{ c.text }}</p></div>
    {%- endfor %}
    <div><h3>{{ p.why.flair_title | soft | safe }}</h3>{{ p.why.flair_text | md | trim | safe }}</div>
  </div>
</div></section>

{%- set q = p.quote_block %}
<section class="harmony"><div class="wrap hm">
  <figure><img data-sizes="(max-width:1000px) 95vw, (min-width:1440px) 1320px, 96vw" src="{{ q.photo }}" alt="{{ q.photo_alt }}"{{ q.photo | imgSize | safe }}></figure>
  <blockquote>
    <p class="tr">{{ q.quote }}</p>
    <cite>{{ q.source }}{% if q.original %} · <span lang="{{ q.original_lang or 'es' }}">{{ q.original }}</span>{% endif %}{% if q.credit %} · {{ q.credit }}{% endif %}</cite>
  </blockquote>
</div></section>

<section id="collaborations">
  <div class="wrap collab-h"><span class="lbl">{{ p.collaborations.eyebrow }}</span><h2>{{ p.collaborations.title | soft | safe }}</h2></div>
  <div class="collab">
    {%- for c in collaborations %}
    <article class="cb"><div class="ph"><span class="vert">{{ c.area }}</span>{% if c.image %}<img src="{{ c.image }}" alt="{{ c.image_alt }}"{{ c.image | imgSize | safe }}{% if c.image_position %} style="object-position:{{ c.image_position }}"{% endif %} loading="lazy">{% endif %}</div><div class="b">
      <h3>{{ c.name }}</h3>
      <p>{{ c.description }}</p>
      {% if c.links and c.links.length %}<div class="links">{% for l in c.links %}<a {{ linkAttrs(l.url) }}>{{ l.label }}{{ arrow(l.url) }}</a>{% endfor %}</div>{% endif %}</div></article>
    {%- endfor %}
  </div>
</section>

{%- set ab = p.about %}{% set t = p.testimonial %}
<section id="about" class="about"><div class="wrap">
  <div style="display:grid;gap:4px;align-content:start"><img src="{{ ab.photo }}" alt="{{ ab.photo_alt }}"{{ ab.photo | imgSize | safe }}>{% if t.quote %}<blockquote class="quote">{{ t.quote }}<cite>{{ t.author }}{% if t.organization %}, {{ t.organization }}{% endif %}</cite></blockquote>{% endif %}</div>
  <div class="t">
    <span class="lbl">{{ ab.eyebrow }}</span>
    <h2>{{ ab.name | soft | safe }}</h2>
    <p style="font-size:21px;font-weight:500">{{ ab.title_line }}</p>
    {{ ab.bio | md | safe }}
    <ul class="chips">{% for r in roles %}{% if r.show_on_sistematica %}{% set chip = r.sistematica_chip or (r.role + ", " + r.organization) %}{% set u = ((site.links.laura | replace("https://", "https://") ) + r.link_url) if (r.link_url and (r.link_url | string).startsWith("/")) else r.link_url %}<li>{% if u %}<a {{ linkAttrs(u) }}>{{ chip }}{{ arrow(u) }}</a>{% else %}{{ chip }}{% endif %}</li>{% endif %}{% endfor %}</ul>
    <div class="actions"><a class="btn" {{ linkAttrs(site.links.laura) }}>{{ ab.profile_label }}</a><a class="btn line" {{ linkAttrs(site.links.linkedin) }}>{{ ab.linkedin_label }} ↗</a></div>
  </div>
</div></section>

{% set c = p.contact %}
{% call contactCard({ field: "deep", label: c.eyebrow, title: c.title | soft, idPrefix: "ks", extended: true, messageLabel: c.message_label, submitLabel: c.submit_label, timelineOptions: c.timeline_options }) %}{{ c.intro | md | trim | safe }}{% endcall %}
