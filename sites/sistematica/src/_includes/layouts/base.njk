<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site.title }}{% if title %}: {{ title }}{% endif %}</title>
  <meta name="description" content="{{ site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="stylesheet" href="/css/shared/tessera.css">
  <link rel="stylesheet" href="/css/site.css">
  <script src="/js/nav.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap site-header__inner">
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>{{ site.title }}</a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" hidden>Menu</button>
      <nav class="site-nav" id="site-nav" aria-label="Main">
        <ul>
          <li><a href="/#what">What I do</a></li>
          <li><a href="/#why">Why Sistem(at)ica</a></li>
          <li><a href="/#collaborations">Collaborations</a></li>
          <li><a href="/#about">About</a></li>
          <li><a href="/#contact">Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__inner">
      <span>&copy; {{ "" | year }} {{ site.title }} · {{ profile.name }}</span>
      <a href="{{ profile.linkedin }}" rel="me noopener">LinkedIn</a>
    </div>
  </footer>
</body>
</html>
